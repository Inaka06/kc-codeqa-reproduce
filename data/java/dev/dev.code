public static String create String ( final char ch , final int num Chars ) { final String Builder builder = new String Builder ( ) ; for ( int i = NUM ; i < num Chars ; ++ i ) { builder . append ( ch ) ; } return builder . to String ( ) ; }
public static String create String ( final char ch , final int num Chars ) { final String Builder builder = new String Builder ( ) ; for ( int i = NUM ; i < num Chars ; ++ i ) { builder . append ( ch ) ; } return builder . to String ( ) ; }
