public static void initialize Schemas ( Map conf , String id ) { System Configuration . set Property ( STRING , ( String ) conf . get ( Storm Constants . DSCHEMA KEY ) ) ; System Configuration . set Property ( STRING , ( String ) conf . get ( Storm Constants . QSCHEMA KEY ) ) ; try { boolean hdfs = ( boolean ) conf . get ( Storm Constants . USE HDFS ) ; if ( hdfs ) { String hdfs Uri = ( String ) conf . get ( Storm Constants . HDFS URI KEY ) ; File System fs = File System . get ( URI . create ( hdfs Uri ) , new Configuration ( ) ) ; Data Schema Loader . initialize ( BOOL , fs ) ; Query Schema Loader . initialize ( BOOL , fs ) ; } else { Data Schema Loader . initialize ( ) ; Query Schema Loader . initialize ( ) ; } } catch ( Exception e ) { logger . error ( STRING , e ) ; throw new Runtime Exception ( e ) ; } }
