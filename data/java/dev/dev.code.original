public abstract void newIndexWriter ( boolean rollback ) throws IOException ;
private void openInBrowserButtonInvoked ( ) { try { final URI uri = URIUtils . newURI ( browserHistory . getCurrentURL ( ) ) ; BrowserFacade . launchURL ( uri , uri . getPath ( ) ) ; } catch ( final IllegalArgumentException e ) { final String messageFormat = Messages . getString ( STRING ) ; final String message = MessageFormat . format ( messageFormat , e . getMessage ( ) ) ; MessageDialog . openError ( browser . getShell ( ) , Messages . getString ( STRING ) , message ) ; } }
private void openInBrowserButtonInvoked ( ) { try { final URI uri = URIUtils . newURI ( browserHistory . getCurrentURL ( ) ) ; BrowserFacade . launchURL ( uri , uri . getPath ( ) ) ; } catch ( final IllegalArgumentException e ) { final String messageFormat = Messages . getString ( STRING ) ; final String message = MessageFormat . format ( messageFormat , e . getMessage ( ) ) ; MessageDialog . openError ( browser . getShell ( ) , Messages . getString ( STRING ) , message ) ; } }
public static void initializeSchemas ( Map conf , String id ) { SystemConfiguration . setProperty ( STRING , ( String ) conf . get ( StormConstants . DSCHEMA_KEY ) ) ; SystemConfiguration . setProperty ( STRING , ( String ) conf . get ( StormConstants . QSCHEMA_KEY ) ) ; try { boolean hdfs = ( boolean ) conf . get ( StormConstants . USE_HDFS ) ; if ( hdfs ) { String hdfsUri = ( String ) conf . get ( StormConstants . HDFS_URI_KEY ) ; FileSystem fs = FileSystem . get ( URI . create ( hdfsUri ) , new Configuration ( ) ) ; DataSchemaLoader . initialize ( _BOOL , fs ) ; QuerySchemaLoader . initialize ( _BOOL , fs ) ; } else { DataSchemaLoader . initialize ( ) ; QuerySchemaLoader . initialize ( ) ; } } catch ( Exception e ) { logger . error ( STRING , e ) ; throw new RuntimeException ( e ) ; } }
public static void initializeSchemas ( Map conf , String id ) { SystemConfiguration . setProperty ( STRING , ( String ) conf . get ( StormConstants . DSCHEMA_KEY ) ) ; SystemConfiguration . setProperty ( STRING , ( String ) conf . get ( StormConstants . QSCHEMA_KEY ) ) ; try { boolean hdfs = ( boolean ) conf . get ( StormConstants . USE_HDFS ) ; if ( hdfs ) { String hdfsUri = ( String ) conf . get ( StormConstants . HDFS_URI_KEY ) ; FileSystem fs = FileSystem . get ( URI . create ( hdfsUri ) , new Configuration ( ) ) ; DataSchemaLoader . initialize ( _BOOL , fs ) ; QuerySchemaLoader . initialize ( _BOOL , fs ) ; } else { DataSchemaLoader . initialize ( ) ; QuerySchemaLoader . initialize ( ) ; } } catch ( Exception e ) { logger . error ( STRING , e ) ; throw new RuntimeException ( e ) ; } }
public void add ( HistoryReference href ) { synchronized ( hrefList ) { hrefList . add ( href ) ; fireTableRowsInserted ( hrefList . size ( ) - _NUM , hrefList . size ( ) - _NUM ) ; } }
