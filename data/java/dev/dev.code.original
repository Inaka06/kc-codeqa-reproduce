private double randomConditionalSurvivalTime ( int x , int y , double t , double [ ] m ) throws NoEventException { double U = MathUtils . nextDouble ( ) ; double vLeft = _NUM ; double vRight = t ; double fLeft = _NUM - U ; double fRight = conditionalSurvivalProbability ( x , t , y , t , m ) - U ; if ( fRight >= _NUM ) { if ( x != y ) { throw new IllegalArgumentException ( STRING + x + STRING + y + STRING + t + STRING + U + STRING + fRight ) ; } throw new NoEventException ( ) ; } double vNew = vLeft ; double vOld = vRight ; double fNew = fLeft ; double fOld = fRight ; while ( Math . abs ( vNew - vOld ) > _NUM ) { double vProp = vNew - fNew / ( ( fOld - fNew ) / ( vOld - vNew ) ) ; if ( ( vLeft >= vProp ) || ( vProp >= vRight ) ) { vProp = vLeft - fLeft / ( ( fRight - fLeft ) / ( vRight - vLeft ) ) ; } double fProp = conditionalSurvivalProbability ( x , vProp , y , t , m ) - U ; vOld = vNew ; fOld = fNew ; vNew = vProp ; fNew = fProp ; if ( fProp < _NUM ) { vRight = vProp ; fRight = fProp ; } else { vLeft = vProp ; fLeft = fProp ; } } return vNew ; }
