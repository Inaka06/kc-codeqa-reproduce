@ SuppressWarnings ( STRING ) public Intervals ( Collection < T > content , Function < T , Double > probs ) { intervals = new Interval [ content . size ( ) ] ; int i = _NUM ; double total = _NUM ; for ( T a : content ) { double prob = probs . apply ( a ) ; if ( prob == Double . NaN ) { throw new RuntimeException ( STRING + a ) ; } intervals [ i ++ ] = new Interval < T > ( a , total , total + prob ) ; total += prob ; } if ( total < _NUM ) { throw new RuntimeException ( STRING + content ) ; } totalProb = total ; }
