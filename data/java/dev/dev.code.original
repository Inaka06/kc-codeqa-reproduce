protected int randomUidValidity ( ) { return Math . abs ( RANDOM . nextInt ( ) ) ; }
protected File createTempDir ( ) throws IOException { File tmp = createTempFile ( STRING ) ; if ( ! tmp . delete ( ) ) { throw new IOException ( STRING + tmp . getPath ( ) + STRING ) ; } tmp . mkdir ( ) ; return tmp ; }
