public final void openFallbackOutputStream ( ) throws DataFallbackException { if ( output == null ) { if ( LOG . isDebugEnabled ( ) ) LOG . debug ( STRING + dataFile . getName ( ) + STRING ) ; try { output = new BufferedWriter ( new FileWriter ( dataFile , _BOOL ) ) ; } catch ( IOException e ) { throw new DataFallbackException ( e . getMessage ( ) ) ; } } }
public final void openFallbackOutputStream ( ) throws DataFallbackException { if ( output == null ) { if ( LOG . isDebugEnabled ( ) ) LOG . debug ( STRING + dataFile . getName ( ) + STRING ) ; try { output = new BufferedWriter ( new FileWriter ( dataFile , _BOOL ) ) ; } catch ( IOException e ) { throw new DataFallbackException ( e . getMessage ( ) ) ; } } }
