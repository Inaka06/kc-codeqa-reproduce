 1 , tidx 1 ) ; final int total = actions . length * next Cnt * tnode . next Size ( ) ; if ( tnode 1 . is Consistent ( s1 , my Tool ) && ( ptr 1 == - NUM || ! node . trans Exists ( fp 1 , tidx 1 ) ) ) { node . add Transition ( fp 1 , tidx 1 , slen , alen , check Action Res , NUM , ( total - cnt ) ) ; writer . write State ( s , tnode , s1 , tnode 1 , check Action Res , NUM , alen , BOOL , Visualization . DOTTED ) ; if ( ptr 1 == - NUM ) { dgraph . record Node ( fp 1 , tidx 1 ) ; if ( is Done ) { add Next State ( s1 , fp 1 , tnode 1 , oos , dgraph ) ; } } } cnt ++ ; } } else { cnt ++ ; } } } if ( num Succ < node . succ Size ( ) ) { node . realign ( ) ; dgraph . add Node ( node ) ; } }
