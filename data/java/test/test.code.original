public Location ( int x , int y , String name , OMGraphic locationMarker ) { setLocation ( x , y ) ; this . name = name ; if ( logger . isLoggable ( Level . FINER ) ) { logger . finer ( STRING + x + STRING + y + STRING + name + STRING ) ; } if ( locationMarker == null ) { location = new OMPoint ( x , y ) ; } else { location = locationMarker ; } label = new OMText ( x , y , name , OMText . JUSTIFY_LEFT ) ; }
public static void selectNodesWithString ( final ZyGraph graph , final String searchString ) { Preconditions . checkNotNull ( graph , STRING ) ; Preconditions . checkNotNull ( searchString , STRING ) ; final GraphSearcher searcher = new GraphSearcher ( ) ; searcher . search ( GraphHelpers . getNodes ( graph ) , new ArrayList < NaviEdge > ( ) , searchString ) ; final List < SearchResult > results = searcher . getResults ( ) ; final List < NaviNode > resultNodes = new ArrayList < NaviNode > ( ) ; for ( final SearchResult searchResult : results ) { resultNodes . add ( ( NaviNode ) searchResult . getObject ( ) ) ; } graph . selectNodes ( resultNodes , _BOOL ) ; searcher . dispose ( ) ; }
