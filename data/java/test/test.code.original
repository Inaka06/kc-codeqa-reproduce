private void addNextState ( final TLCState s , final long fp , final TBGraphNode tnode , final OrderOfSolution oos , final TableauDiskGraph dgraph ) throws IOException { final boolean [ ] checkStateRes = oos . checkState ( s ) ; final int slen = checkStateRes . length ; final int alen = oos . getCheckAction ( ) . length ; final GraphNode node = dgraph . getNode ( fp , tnode . getIndex ( ) ) ; final int numSucc = node . succSize ( ) ; node . setCheckState ( checkStateRes ) ; int cnt = _NUM ; final int nextSize = tnode . nextSize ( ) ; final BitVector checkActionResults = nextSize > _NUM ? oos . checkAction ( s , s , new BitVector ( alen ) , _NUM ) : null ; for ( int i = _NUM ; i < nextSize ; i ++ ) { final TBGraphNode tnode1 = tnode . nextAt ( i ) ; final int tidx1 = tnode1 . getIndex ( ) ; final long ptr1 = dgraph . getPtr ( fp , tidx1 ) ; if ( tnode1 . isConsistent ( s , myTool ) && ( ptr1 == - _NUM || ! node . transExists ( fp , tidx1 ) ) ) { node . addTransition ( fp , tidx1 , slen , alen , checkActionResults , _NUM , ( nextSize - cnt ) ) ; if ( ptr1 == - _NUM ) { dgraph . recordNode ( fp , tnode1 . getIndex ( ) ) ; addNextState ( s , fp , tnode1 , oos , dgraph ) ; } } cnt ++ ; } cnt = _NUM ; for ( int i = _NUM ; i < actions . length ; i ++ ) { final StateVec nextStates = myTool . getNextStates ( actions [ i ] , s ) ; final int nextCnt = nextStates . size ( ) ; for ( int j = _NUM ; j < nextCnt ; j ++ ) { final TLCState s1 = nextStates . elementAt ( j ) ; if ( myTool . isInModel ( s1 ) && myTool . isInActions ( s , s1 ) ) { final long fp1 = s1 . fingerPrint ( ) ; final BitVector checkActionRes = oos . checkAction ( s , s1 , new BitVector ( alen ) , _NUM ) ; boolean isDone = dgraph . isDone ( fp1 ) ; for ( int k = _NUM ; k < tnode . nextSize ( ) ; k ++ ) { final TBGraphNode tnode1 = tnode . nextAt ( k ) ; final int tidx1 = tnode1 . getIndex ( ) ; long ptr1 = dgraph . getPtr ( fp1 , tidx1 ) ; final int total = actions . length * nextCnt * tnode . nextSize ( ) ; if ( tnode1 . isConsistent ( s1 , myTool ) && ( ptr1 == - _NUM || ! node . transExists ( fp1 , tidx1 ) ) ) { node . addTransition ( fp1 , tidx1 , slen , alen , checkActionRes , _NUM , ( total - cnt ) ) ; writer . writeState ( s , tnode , s1 , tnode1 , checkActionRes , _NUM , alen , _BOOL , Visualization . DOTTED ) ; if ( ptr1 == - _NUM ) { dgraph . recordNode ( fp1 , tidx1 ) ; if ( isDone ) { addNextState ( s1 , fp1 , tnode1 , oos , dgraph ) ; } } } cnt ++ ; } } else { cnt ++ ; } } } if ( numSucc < node . succSize ( ) ) { node . realign ( ) ; dgraph . addNode ( node ) ; } }
